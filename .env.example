# PM Cosmetics Hub - Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to Git!

# ============================================
# API KEYS & AUTHENTICATION
# ============================================
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token

INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_account_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

ETSY_API_KEY=your_etsy_api_key
ETSY_API_SECRET=your_etsy_api_secret

WHATSAPP_BUSINESS_PHONE_NUMBER_ID=your_whatsapp_phone_id
WHATSAPP_BUSINESS_ACCESS_TOKEN=your_whatsapp_access_token

NOTION_API_KEY=your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id

GITHUB_TOKEN=your_github_token
GITHUB_REPO=Pmcosmetics/pmcosmetics-empire-11countries

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/pmcosmetics
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/pmcosmetics

# ============================================
# STRIPE PAYMENTS (if using Stripe)
# ============================================
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# ============================================
# EMAIL SERVICE
# ============================================
SENDGRID_API_KEY=your_sendgrid_api_key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# ============================================
# SECURITY
# ============================================
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_key_here

# ============================================
# ANALYTICS
# ============================================
GOOGLE_ANALYTICS_ID=your_ga_id
MIXPANEL_TOKEN=your_mixpanel_token

# ============================================
# DEPLOYMENT
# ============================================
VERCEL_DEPLOYMENT_URL=your_vercel_url
GITHUB_PAGES_URL=https://pmcosmetics.github.io/pmcosmetics-empire-11countries
