{
  "name": "pmcosmetics-empire-11countries",
  "version": "1.0.0",
  "description": "PM Cosmetics Hub - E-Commerce Empire for Beauty Products Across 11 Countries",
  "private": true,
  "author": "PM Cosmetics",
  "license": "PRIVATE",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "validate:inventory": "node scripts/validate-inventory.mjs",
    "sync:inventory": "node scripts/sync-inventory.mjs",
    "sync:prices": "node scripts/sync-prices.mjs",
    "sync:all": "npm run sync:inventory && npm run sync:prices",
    "generate:reports": "node scripts/generate-reports.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,json,md,yml}\"",
    "deploy": "npm run build && npm run validate",
    "precommit": "npm run lint && npm run validate"
  },
  "dependencies": {
    "express": "^4.18.2",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "jsonschema": "^1.4.1",
    "shopify-api": "^12.0.0",
    "stripe": "^14.0.0",
    "nodemailer": "^6.9.7",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "winston": "^3.11.0",
    "uuid": "^9.0.1",
    "date-fns": "^2.30.0",
    "lodash": "^4.17.21",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "typescript": "^5.3.3",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.1.5"
  }
}
